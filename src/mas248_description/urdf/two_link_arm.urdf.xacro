<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mas248_two_link_arm">

  <!-- MAS248 Lecture 8: two REVOLUTE joints, plus a FIXED TCP frame. -->
  <!-- Units: metres, kilograms and radians. No real hardware is controlled. -->
  <xacro:property name="link1_length" value="0.40"/>
  <xacro:property name="link2_length" value="0.30"/>
  <xacro:property name="arm_radius" value="0.035"/>

  <material name="MAS248Blue"><color rgba="0.14 0.49 0.86 1"/></material>
  <material name="MAS248Silver"><color rgba="0.75 0.81 0.88 1"/></material>
  <material name="MAS248Orange"><color rgba="1.0 0.33 0.04 1"/></material>

  <!-- Base: fixed reference at the world origin. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry><cylinder radius="0.09" length="0.14"/></geometry>
      <material name="MAS248Blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry><cylinder radius="0.09" length="0.14"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.07"/>
      <mass value="1.0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.004"/>
    </inertial>
  </link>

  <!-- Link geometry extends along local +X; cylinder axis rotated from Z to X. -->
  <link name="link1">
    <visual>
      <origin xyz="${link1_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="${arm_radius}" length="${link1_length}"/></geometry>
      <material name="MAS248Silver"/>
    </visual>
    <collision>
      <origin xyz="${link1_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="${arm_radius}" length="${link1_length}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="${link1_length/2} 0 0"/>
      <mass value="0.30"/>
      <inertia ixx="0.000184" ixy="0" ixz="0" iyy="0.00409" iyz="0" izz="0.00409"/>
    </inertial>
  </link>

  <link name="link2">
    <visual>
      <origin xyz="${link2_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="${arm_radius}" length="${link2_length}"/></geometry>
      <material name="MAS248Blue"/>
    </visual>
    <collision>
      <origin xyz="${link2_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="${arm_radius}" length="${link2_length}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="${link2_length/2} 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.000153" ixy="0" ixz="0" iyy="0.00200" iyz="0" izz="0.00200"/>
    </inertial>
  </link>

  <!-- Joint 1 and joint 2 both rotate about local Z, giving a planar XY arm. -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="${link1_length} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- EXERCISE 1: change joint2 limits to -0.80 ... +0.80 radians. -->
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- TCP is rigidly attached at the end of link2. -->
  <link name="tcp">
    <visual>
      <geometry><sphere radius="0.022"/></geometry>
      <material name="MAS248Orange"/>
    </visual>
  </link>
  <joint name="tcp_joint" type="fixed">
    <parent link="link2"/>
    <child link="tcp"/>
    <origin xyz="${link2_length} 0 0" rpy="0 0 0"/>
  </joint>

  <!-- EXERCISE 2: add a NEW rigid fixture to the base (do not alter the TCP). -->
  <!-- Add a <link name="fixture_link"> with a small <box> visual, AND a -->
  <!-- <joint name="fixture_joint" type="fixed"> from base_link to fixture_link. -->
  <!-- Suggested joint origin: xyz="-0.12 0.22 0.12" rpy="0 0 0". -->
  <!-- Verify base_link -> fixture_link remains fixed while joint1/joint2 move. -->

</robot>
