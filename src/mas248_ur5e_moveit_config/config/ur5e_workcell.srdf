<?xml version="1.0" ?>
<robot name="mas248_ur5e">
  <!-- No virtual world->base joint: 'world' is already a real URDF link fixed to pedestal. -->
  <group name="manipulator"><chain base_link="base_link" tip_link="tcp"/></group>
  <group_state name="home" group="manipulator">
    <joint name="shoulder_pan_joint" value="0"/><joint name="shoulder_lift_joint" value="-1.57"/>
    <joint name="elbow_joint" value="1.57"/><joint name="wrist_1_joint" value="-1.57"/>
    <joint name="wrist_2_joint" value="-1.57"/><joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="ready" group="manipulator">
    <joint name="shoulder_pan_joint" value="0.3"/><joint name="shoulder_lift_joint" value="-1.3"/>
    <joint name="elbow_joint" value="1.4"/><joint name="wrist_1_joint" value="-1.5"/>
    <joint name="wrist_2_joint" value="-1.57"/><joint name="wrist_3_joint" value="0"/>
  </group_state>
  <!-- Conservative adjacent pairs only. Review actual geometry in Setup Assistant. -->
  <disable_collisions link1="world" link2="pedestal_link" reason="Adjacent"/>
  <disable_collisions link1="pedestal_link" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="flange" reason="Adjacent"/>
  <disable_collisions link1="flange" link2="tool0" reason="Adjacent"/>
<!-- ADD MORE COLLISIONS HERE (RED LINKS IN RVIZ) -->
  <!-- Verktoy (spindel/tusj) er festet paa tool0 og ligger inntil handleddet -->
  <disable_collisions link1="spindle" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="spindle" link2="flange" reason="Adjacent"/>
  <disable_collisions link1="spindle" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="spindle" link2="tcp" reason="Adjacent"/>
  <!-- Roboten staar oppaa pedestalen -->
  <disable_collisions link1="pedestal_link" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="pedestal_link" link2="shoulder_link" reason="Never"/>
</robot>
