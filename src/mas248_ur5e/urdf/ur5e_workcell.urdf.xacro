<?xml version="1.0"?>
<robot name="mas248_ur5e" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Main arguments -->
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:arg name="safety_limits" default="true"/>
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="use_fake_hardware" default="true"/>

  <!-- Vendor robot model (keep original package untouched) -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/> <!-- Here we define the original UR5e model from a driver -->


<!-- TO BE DONE TODAY  beginning-->

   <!-- Egne mål (meter) -->
  <!-- Mål lest fra STL-filene (SolidWorks, mm, Y opp, origo i et hjørne) -->
  <xacro:property name="pedestal_height" value="0.301"/>   <!-- pedestal.STL: 300 x 301 (Y) x 300 mm -->
  <xacro:property name="pedestal_size" value="0.300"/>
  <xacro:property name="tool_length" value="0.138"/>       <!-- spindle.STL: 46.5 x 138 (Y) x 46.5 mm -->
  <xacro:property name="tool_diameter" value="0.0465"/>
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>  <!-- STL er i mm -->
  <xacro:property name="tool_changer_offset" value="0.000"/>
  <xacro:property name="pen_axis_offset" value="0.094"/>

  <link name="world"/>

  <link name="pedestal_link">
    <visual>
      <!-- rpy: SolidWorks Y-opp -> ROS Z-opp. xyz: flytter hjørne-origo til midt under pedestalen -->
      <origin xyz="${-pedestal_size/2} ${pedestal_size/2} 0" rpy="${pi/2} 0 0"/>
      <geometry><mesh filename="package://mas248_ur5e/meshes/pedestal.STL" scale="${mesh_scale}"/></geometry>
    </visual>
    <collision>  <!-- enkel boks for MoveIt; tilpass størrelsen -->
      <origin xyz="0 0 ${pedestal_height/2}" rpy="0 0 0"/>
      <geometry><box size="${pedestal_size} ${pedestal_size} ${pedestal_height}"/></geometry>
    </collision>
  </link>

  <joint name="world_to_pedestal" type="fixed">
    <parent link="world"/>
    <child link="pedestal_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="spindle">
    <visual>
      <!-- rpy: SolidWorks Y-akse -> ut fra tool0 (Z). xyz: sentrerer verktøyet på flensen -->
      <origin xyz="${-tool_diameter/2} ${tool_diameter/2} 0" rpy="${pi/2} 0 0"/>
      <geometry><mesh filename="package://mas248_ur5e/meshes/spindle.STL" scale="${mesh_scale}"/></geometry>
    </visual>
    <!-- Kollisjon tilpasset spindle.STL (malt i spindel-rammen, mm): pennen er D15 ved y=-40,
         z 0..43; selve verktoykroppen er 46.5 x 86.5 mm (x, y = -63.2..23.2) for z 43..148.
         2 mm margin. Nederste 10 mm av pennen er utelatt, ellers blir tegning paa papiret "kollisjon". -->
    <collision>  <!-- verktoykropp -->
      <origin xyz="0 -0.020 0.0955" rpy="0 0 0"/>
      <geometry><box size="0.0505 0.0905 0.109"/></geometry>
    </collision>
    <collision>  <!-- penn (uten de nederste 10 mm) -->
      <origin xyz="0 -0.040 0.0265" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0095" length="0.033"/></geometry>
    </collision>
  </link>

  <link name="tcp"/>

  <joint name="tool0_to_spindle" type="fixed">
    <parent link="tool0"/>
    <child link="spindle"/>
    <origin xyz="0 ${pen_axis_offset} ${tool_changer_offset + tool_diameter/2}" rpy="${-pi/2} 0 ${-pi}"/>
  </joint>

  <joint name="spindle_to_tcp" type="fixed">
    <parent link="spindle"/>
    <child link="tcp"/>
    <origin xyz="0 -0.040 0" rpy="${pi} 0 0"/>
  </joint>

<!-- TO BE DONE TODAY  The end -->

  <!-- Instantiate UR robot -->
  <xacro:ur_robot
    name="$(arg name)"
    ur_type="$(arg ur_type)"
    tf_prefix="$(arg tf_prefix)"
    parent="pedestal_link"
    joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="0.15"
    safety_k_position="20"
    generate_ros2_control_tag="false"
    use_fake_hardware="$(arg use_fake_hardware)"
    headless_mode="true"
    robot_ip="$(arg robot_ip)"
    script_filename=""
    input_recipe_filename=""
    output_recipe_filename=""
  >
    <!-- Mount the robot on top of the pedestal use right dimensions-->
    <origin xyz="0 0 ${pedestal_height}" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- Arbeidsbord: IRL ligger bordplata i samme hoyde som gulvet pedestalen staar paa (z = 0).
       Endre table_* hvis bordets plassering/storrelse i labben er annerledes (mal fra pedestalens senter). -->
  <xacro:property name="table_size_x" value="1.20"/>
  <xacro:property name="table_size_y" value="0.80"/>
  <xacro:property name="table_thickness" value="0.05"/>
  <xacro:property name="table_center_x" value="0.85"/>
  <xacro:property name="table_top_z" value="0.0"/>
  <link name="table_link">
    <visual>
      <origin xyz="${table_center_x} 0 ${table_top_z - table_thickness/2}" rpy="0 0 0"/>
      <geometry><box size="${table_size_x} ${table_size_y} ${table_thickness}"/></geometry>
      <material name="table"><color rgba="0.75 0.75 0.78 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="${table_center_x} 0 ${table_top_z - table_thickness/2}" rpy="0 0 0"/>
      <geometry><box size="${table_size_x} ${table_size_y} ${table_thickness}"/></geometry>
    </collision>
  </link>
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- A4-ark (kun visuelt, ingen kollisjon: pennen skal tegne paa det). Liggende: lang side langs world Y.
       PAA LAB: maal arkets senter med pennetuppen (tf2_echo world tcp) og sett paper_center_x/y (og paper_yaw).
       Bruk SAMME verdier i image_to_targets (center-x, center-y, yaw-deg, og center-z = table_top_z + ca. 0.001). -->
  <xacro:property name="paper_center_x" value="0.4885"/>
  <xacro:property name="paper_center_y" value="0.0"/>
  <xacro:property name="paper_yaw" value="0.0"/>
  <link name="a4_paper">
    <visual>
      <origin xyz="0 0 0.00025" rpy="0 0 0"/>
      <geometry><box size="0.210 0.297 0.0005"/></geometry>
      <material name="paper"><color rgba="1.0 1.0 1.0 1.0"/></material>
    </visual>
  </link>
  <joint name="table_to_a4_paper" type="fixed">
    <parent link="table_link"/>
    <child link="a4_paper"/>
    <origin xyz="${paper_center_x} ${paper_center_y} ${table_top_z}" rpy="0 0 ${paper_yaw}"/>
  </joint>

  <!-- Arbeidsomraade: to virtuelle vegger sideveis (world Y), 60 cm til hver side av roboten (120 cm totalt).
       MoveIt ser veggene som hindringer, saa INGEN del av roboten eller verktoyet planlegges utenfor.
       De er gjennomsiktige i RViz og finnes ikke fysisk. -->
  <xacro:property name="workspace_width" value="1.20"/>
  <xacro:property name="wall_thickness" value="0.02"/>
  <xacro:property name="wall_x_min" value="-0.50"/>
  <xacro:property name="wall_x_max" value="1.45"/>
  <xacro:property name="wall_height" value="1.50"/>
  <xacro:macro name="workspace_wall" params="side">
    <visual>
      <origin xyz="${(wall_x_min + wall_x_max)/2} ${side*(workspace_width/2 + wall_thickness/2)} ${wall_height/2}" rpy="0 0 0"/>
      <geometry><box size="${wall_x_max - wall_x_min} ${wall_thickness} ${wall_height}"/></geometry>
      <material name="workspace_wall"><color rgba="1.0 0.3 0.2 0.15"/></material>
    </visual>
    <collision>
      <origin xyz="${(wall_x_min + wall_x_max)/2} ${side*(workspace_width/2 + wall_thickness/2)} ${wall_height/2}" rpy="0 0 0"/>
      <geometry><box size="${wall_x_max - wall_x_min} ${wall_thickness} ${wall_height}"/></geometry>
    </collision>
  </xacro:macro>
  <link name="workspace_walls">
    <xacro:workspace_wall side="1"/>
    <xacro:workspace_wall side="-1"/>
  </link>
  <joint name="world_to_workspace_walls" type="fixed">
    <parent link="world"/>
    <child link="workspace_walls"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
